@model ArticlesApp.Models.Comment

@{
    ViewBag.Title = "Detalii comentariu";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Detalii comentariu</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success" href="/Comments/Index">
            <i class="bi bi-card-list"></i> Lista comentarii
        </a>
        <a class="btn btn-outline-success" href="/Comments/New?articleId=@Model.ArticleId">
            <i class="bi bi-plus-circle"></i> Adauga comentariu
        </a>
    </div>
</div>

<br />

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Article?.Title</h4>
        <p class="card-text">@Model.Content</p>
        <small class="text-muted">
            <i class="bi bi-clock"></i> @Model.Date.ToString("dd MMM yyyy HH:mm")
        </small>
    </div>

    <div class="card-footer d-flex justify-content-between">
        <a class="btn btn-secondary" href="/Comments/Edit/@Model.Id">
            <i class="bi bi-pencil"></i> Editeaza
        </a>
        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-danger" type="submit">
                <i class="bi bi-trash"></i> Sterge
            </button>
        </form>
    </div>
</div>

<br />

<a class="btn btn-outline-primary" href="/Articles/Show/@Model.ArticleId">
    <i class="bi bi-arrow-left"></i> Inapoi la articol
</a>

