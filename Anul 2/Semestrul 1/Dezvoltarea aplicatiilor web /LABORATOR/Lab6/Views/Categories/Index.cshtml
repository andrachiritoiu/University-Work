
@model IEnumerable<ArticlesApp.Models.Category>

@{
    ViewBag.Title = "Lista categorii";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@ViewBag.Title</h2>
    <a class="btn btn-outline-secondary" href="/Articles/Index">
        <i class="bi bi-newspaper"></i> Inapoi la articole
    </a>
</div>

<div class="mb-3">
    <a class="btn btn-success" href="/Categories/New">
        <i class="bi bi-plus-circle"></i> Adauga categorie
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Nu exista categorii momentan.</div>
}
else
{
    <div class="list-group">
        @foreach (var category in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">
                        <i class="bi bi-tag"></i> @category.CategoryName
                    </h5>
                    <small class="text-muted">@((category.Articles?.Count ?? 0)) articole</small>
                </div>
                <div class="btn-group">
                    <a class="btn btn-outline-primary" href="/Categories/Show/@category.Id">
                        <i class="bi bi-eye"></i> Detalii
                    </a>
                    <a class="btn btn-outline-secondary" href="/Categories/Edit/@category.Id">
                        <i class="bi bi-pencil"></i> Editeaza
                    </a>
                </div>
            </div>
        }
    </div>
}

