CREATE TABLE octombrie_caf(
    id NUMBER(6),
    data DATE
);

DECLARE
    v_data_inceput DATE := DATE '2025-10-01';
    v_data_sfarsit DATE := DATE '2025-10-31';
    v_cnt NUMBER :=1;

BEGIN
    WHILE v_data_inceput <= v_data_sfarsit LOOP
        INSERT INTO octombrie_caf(id, data)
